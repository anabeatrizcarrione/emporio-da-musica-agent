# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the agent. Any Claude model with tool use works,
# e.g. claude-sonnet-5-5 or claude-haiku-5-5 for lower cost.
EMPORIO_MODEL=claude-opus-5-5

# Thinking effort (low | medium | high). "low" keeps chat replies fast.
EMPORIO_EFFORT=low

# "Today" as seen by the agent (YYYY-MM-DD or YYYY-MM-DDTHH:MM).
# The provided dataset ends in March 2026, so the demo pins the clock to a date
# just after the last order. Leave empty to use the real current date/time.
EMPORIO_REFERENCE_DATE=2026-03-25T10:00
